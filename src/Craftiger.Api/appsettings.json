{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiOptions": {
    "ArtifactsDir": "artifacts",
    "SolveCacheSize": 16
  },
  "GarageRules": {
    "AlwaysOwnedMachines": [ "Crafting Table", "Furnace", "Mining" ],
    // The Godforge smelts with star heat, not coils (spec §9).
    "HeatExemptMachines": [ "Helioflux Melting Core" ],
    // Only the EBF gains 100 heat per hatch tier above MV (spec §2).
    "HeatBonusMachines": [ "Electric Blast Furnace" ]
  },
  "SolverPreferences": {
    // Tied routes resolve to the best-ranked material form (spec §5).
    "LeafClassPriority": [ "ingot", "gem", "dust", "nugget", "dust_small", "dust_tiny" ]
  }
}
