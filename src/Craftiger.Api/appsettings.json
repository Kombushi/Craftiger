{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiOptions": {
    "ArtifactsDir": "artifacts",
    "SolveCacheSize": 16,
    "FactoryCacheSize": 64,
    "FactoryTimeLimitSeconds": 120,
    // Required: the Valkey that keeps solved tables across processes; set per environment.
    "Valkey": { "ConnectionString": "" }
  },
  "GarageRules": {
    "AlwaysOwnedMachines": [ "Crafting Table", "Furnace", "Mining" ],
    // The Godforge smelts with star heat, not coils.
    "HeatExemptMachines": [ "Helioflux Melting Core" ],
    // Only the EBF gains 100 heat per hatch tier above MV.
    "HeatBonusMachines": [ "Electric Blast Furnace" ]
  },
  "SolverPreferences": {
    // Tied routes resolve to the best-ranked material form.
    "LeafClassPriority": [ "ingot", "gem", "dust", "nugget", "dust_small", "dust_tiny" ]
  },
  "CostSolverOptions": {
    "Epsilon": 1e-9,
    "MaxPassesPerRecipe": 200
  },
  "BomOptions": {
    "PivotEpsilon": 1e-12,
    "MaxWholeRounds": 100000
  },
  "FactorySolverOptions": {
    "PruneFactor": 4.0,
    "PruneFloor": 1.0,
    "GeneratorPruneFloor": 1e-3,
    "RateEpsilon": 1e-5,
    "LayerTolerance": 1e-3
  },
  "HighsOptions": {
    "EquilibrationPasses": 3,
    "DustFloor": 1e-6,
    "LockPad": 1e-9
  }
}
